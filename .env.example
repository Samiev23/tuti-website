# ─────────────────────────────────────────────────────────────
# Tuti Admin Panel — переменные окружения.
# Скопируйте в .env.local (в git не попадает) и заполните.
# Публичный сайт tutitj.com работает и без них.
# ─────────────────────────────────────────────────────────────

# Firebase Web SDK — только вход администратора.
# Firebase Console → Project settings → Your apps → Web app (</>) → SDK setup.
# Проект: tuti-tj
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tuti-tj.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tuti-tj
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tuti-tj.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=425433294161
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK — сервер (API-роуты /api/admin/*) и scripts/set-admin.mjs.
# Firebase Console → Project settings → Service accounts → Generate new private key.
# Значение: содержимое JSON-файла одной строкой ИЛИ тот же JSON в base64.
# ВАЖНО: ключ секретный, в репозиторий не коммитить.
FIREBASE_SERVICE_ACCOUNT_KEY=
